# Spidy Shop - Environment Configuration Example
PORT=3000

# Put your Resend API Key here (Starts with re_)
RESEND_API_KEY=your_resend_api_key_here

# Recipient Email for Order Notifications
NOTIFICATION_EMAIL=spidyshop.bng@gmail.com

# Sender Email Address (Default Resend testing domain is onboarding@resend.dev)
SENDER_EMAIL=Spidy Shop <onboarding@resend.dev>
